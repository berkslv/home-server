# Written by cloudflare/setup.sh
TUNNEL_TOKEN=

# Public keys allowed to SSH into the agent container (newline separated, quote it)
AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@laptop"

TZ=Europe/Istanbul

# GitHub fine-grained PAT for gh/git inside the agent (optional)
GH_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=

# agent-cron: jobs are open issues labeled agent-job in this private repo, opened by JOBS_OWNER
JOBS_REPO=
JOBS_OWNER=
OPENCODE_MODEL=openrouter/...
OPENROUTER_API_KEY=
# Job notifications by email (https://resend.com/api-keys)
RESEND_API_KEY=
NOTIFICATION_EMAIL=
# Sender on a domain verified in Resend; default onboarding@resend.dev only reaches your own Resend address
RESEND_FROM=
